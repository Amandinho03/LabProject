# Server Configuration
PORT=3000

# Authentication & JWT Secrets (Replace with strong random strings in .env)
SECRET_KEY=replace_with_random_secret_key
ACCESS_TOKEN_SECRET=replace_with_access_token_secret
REFRESH_TOKEN_SECRET=replace_with_refresh_token_secret

# Default Admin Bootstrap Password
ADMIN_PASSWORD=change_this_admin_password

# SMTP / Email Notification Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password